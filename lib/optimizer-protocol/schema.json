{
  "openapi": "3.1.0",
  "info": {
    "title": "Optimizer API",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "optimizer_server_src_api_health_health",
        "summary": "Health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/which_search": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_which_search",
        "summary": "Which Search",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhichSearchResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhichSearchRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/submit_feedback": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_submit_feedback",
        "summary": "Submit Feedback",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitFeedbackResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitFeedbackRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/ui/searches": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_searches_list_searches",
        "summary": "List Searches",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "provider",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "feedback",
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "good",
                    "bad",
                    "none"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feedback"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "category_l1",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category L1"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPageOut"
                }
              }
            }
          }
        },
        "description": "Newest first. `category_l1=-1` selects unclassified searches.",
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/stats/providers": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_stats_provider_stats",
        "summary": "Provider Stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatsOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/stats/traffic": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_stats_traffic",
        "summary": "Traffic",
        "parameters": [
          {
            "in": "query",
            "name": "minutes",
            "schema": {
              "default": 60,
              "title": "Minutes",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "bucket_seconds",
            "schema": {
              "default": 60,
              "title": "Bucket Seconds",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrafficOut"
                }
              }
            }
          }
        },
        "description": "Searches per time bucket over the trailing `minutes`, oldest bucket first.\n\nEmpty buckets are included so the series is continuous.",
        "tags": [
          "ui"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "WhichSearchResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "feedback_token"
        ],
        "title": "WhichSearchResponse",
        "type": "object"
      },
      "WhichSearchRequest": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Available Providers",
            "type": "array"
          },
          "override_query_category": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Override Query Category"
          }
        },
        "required": [
          "query",
          "available_providers"
        ],
        "title": "WhichSearchRequest",
        "type": "object"
      },
      "SubmitFeedbackResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "SubmitFeedbackResponse",
        "type": "object"
      },
      "SubmitFeedbackRequest": {
        "properties": {
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          },
          "is_good": {
            "title": "Is Good",
            "type": "boolean"
          }
        },
        "required": [
          "feedback_token",
          "is_good"
        ],
        "title": "SubmitFeedbackRequest",
        "type": "object"
      },
      "SearchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "type": "string"
            },
            "title": "Available Providers",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "category_l1": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L1"
          },
          "category_l2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L2"
          },
          "category_source": {
            "title": "Category Source",
            "type": "string"
          },
          "is_good": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Good"
          },
          "feedback_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback At"
          }
        },
        "required": [
          "id",
          "created_at",
          "query",
          "available_providers",
          "provider",
          "category_l1",
          "category_l2",
          "category_source",
          "is_good",
          "feedback_at"
        ],
        "title": "SearchOut",
        "type": "object"
      },
      "SearchPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchOut"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "SearchPageOut",
        "type": "object"
      },
      "ProviderStatsOut": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "num_searches": {
            "title": "Num Searches",
            "type": "integer"
          },
          "num_feedback": {
            "title": "Num Feedback",
            "type": "integer"
          },
          "num_good": {
            "title": "Num Good",
            "type": "integer"
          },
          "good_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Good Rate"
          }
        },
        "required": [
          "provider",
          "num_searches",
          "num_feedback",
          "num_good",
          "good_rate"
        ],
        "title": "ProviderStatsOut",
        "type": "object"
      },
      "TrafficBucketOut": {
        "properties": {
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "by_provider": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "By Provider",
            "type": "object"
          },
          "good": {
            "title": "Good",
            "type": "integer"
          },
          "bad": {
            "title": "Bad",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "by_provider",
          "good",
          "bad",
          "pending"
        ],
        "title": "TrafficBucketOut",
        "type": "object"
      },
      "TrafficOut": {
        "properties": {
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "bucket_seconds": {
            "title": "Bucket Seconds",
            "type": "integer"
          },
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/TrafficBucketOut"
            },
            "title": "Buckets",
            "type": "array"
          }
        },
        "required": [
          "start",
          "end",
          "bucket_seconds",
          "buckets"
        ],
        "title": "TrafficOut",
        "type": "object"
      }
    }
  },
  "servers": []
}