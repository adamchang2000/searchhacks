{
  "openapi": "3.1.0",
  "info": {
    "title": "Optimizer API",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "optimizer_server_src_api_health_health",
        "summary": "Health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/which_search": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_which_search",
        "summary": "Which Search",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhichSearchResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhichSearchRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/submit_feedback": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_submit_feedback",
        "summary": "Submit Feedback",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitFeedbackResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitFeedbackRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/searches": {
      "get": {
        "operationId": "optimizer_server_src_api_searches_list_searches",
        "summary": "List Searches",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/stats/providers": {
      "get": {
        "operationId": "optimizer_server_src_api_stats_provider_stats",
        "summary": "Provider Stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatsOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "dashboard"
        ]
      }
    }
