{
  "openapi": "3.1.0",
  "info": {
    "title": "Optimizer API",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "optimizer_server_src_api_health_health",
        "summary": "Health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/which_search": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_which_search",
        "summary": "Which Search",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhichSearchResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhichSearchRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/submit_feedback": {
      "post": {
        "operationId": "optimizer_server_src_api_optimizer_submit_feedback",
        "summary": "Submit Feedback",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitFeedbackResponse"
                }
              }
            }
          }
        },
        "tags": [
          "optimizer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitFeedbackRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/ui/searches": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_searches_list_searches",
        "summary": "List Searches",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "provider",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "feedback",
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "good",
                    "bad",
                    "none"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feedback"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "category_l1",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category L1"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPageOut"
                }
              }
            }
          }
        },
        "description": "Newest first. `category_l1=-1` selects unclassified searches.",
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/stats/providers": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_stats_provider_stats",
        "summary": "Provider Stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatsOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/stats/traffic": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_stats_traffic",
        "summary": "Traffic",
        "parameters": [
          {
            "in": "query",
            "name": "minutes",
            "schema": {
              "default": 60,
              "title": "Minutes",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "bucket_seconds",
            "schema": {
              "default": 60,
              "title": "Bucket Seconds",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrafficOut"
                }
              }
            }
          }
        },
        "description": "Searches per time bucket over the trailing `minutes`, oldest bucket first.\n\nEmpty buckets are included so the series is continuous.",
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/distribution/history": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_distribution_history",
        "summary": "History",
        "parameters": [
          {
            "in": "query",
            "name": "l1",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "L1"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "max_points",
            "schema": {
              "default": 240,
              "title": "Max Points",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistributionHistoryOut"
                }
              }
            }
          }
        },
        "description": "Evenly thinned to at most `max_points` snapshots. The latest and every reset snapshot are\nalways included (the dashboard replays from the last reset).",
        "tags": [
          "ui"
        ]
      }
    },
    "/api/ui/distribution/{distribution_id}/categories": {
      "get": {
        "operationId": "optimizer_server_src_api_ui_distribution_categories",
        "summary": "Categories",
        "parameters": [
          {
            "in": "path",
            "name": "distribution_id",
            "schema": {
              "title": "Distribution Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotCategoriesOut"
                }
              }
            }
          }
        },
        "tags": [
          "ui"
        ]
      }
    },
    "/api/admin/reload-search-distribution": {
      "post": {
        "operationId": "optimizer_server_src_api_admin_reload_search_distribution",
        "summary": "Reload Search Distribution",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchDistributionStatus"
                }
              }
            }
          }
        },
        "description": "Load the latest SearchDistribution snapshot into memory. Called by optimizer-recompute.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/reset-search-distribution": {
      "post": {
        "operationId": "optimizer_server_src_api_admin_reset_search_distribution",
        "summary": "Reset Search Distribution",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchDistributionStatus"
                }
              }
            }
          }
        },
        "description": "Route uniformly from now on: write a Beta(1, 1) snapshot, start counting feedback afresh\n(only searches after now), and load it. History and Search/Feedback rows are kept.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/search-distribution": {
      "get": {
        "operationId": "optimizer_server_src_api_admin_search_distribution",
        "summary": "Search Distribution",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchDistributionStatus"
                }
              }
            }
          }
        },
        "description": "The snapshot the server is currently routing with.",
        "tags": [
          "admin"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SearchProvider": {
        "enum": [
          "brave",
          "ceramic",
          "exa",
          "linkup",
          "parallel",
          "perplexity",
          "seltz",
          "serpapi",
          "tavily",
          "tinyfish",
          "you"
        ],
        "title": "SearchProvider",
        "type": "string"
      },
      "WhichSearchResponse": {
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/SearchProvider"
          },
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "feedback_token"
        ],
        "title": "WhichSearchResponse",
        "type": "object"
      },
      "WhichSearchRequest": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "$ref": "#/components/schemas/SearchProvider"
            },
            "minItems": 1,
            "title": "Available Providers",
            "type": "array"
          },
          "override_query_category": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Override Query Category"
          }
        },
        "required": [
          "query",
          "available_providers"
        ],
        "title": "WhichSearchRequest",
        "type": "object"
      },
      "SubmitFeedbackResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "SubmitFeedbackResponse",
        "type": "object"
      },
      "FeedbackRecord": {
        "additionalProperties": false,
        "properties": {
          "purchase_conversion": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Conversion"
          },
          "user_confirmed_outcome": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Confirmed Outcome"
          },
          "user_stopped_following_up": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Stopped Following Up"
          }
        },
        "title": "FeedbackRecord",
        "type": "object"
      },
      "SubmitFeedbackRequest": {
        "properties": {
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          },
          "feedback": {
            "$ref": "#/components/schemas/FeedbackRecord"
          }
        },
        "required": [
          "feedback_token",
          "feedback"
        ],
        "title": "SubmitFeedbackRequest",
        "type": "object"
      },
      "SearchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "type": "string"
            },
            "title": "Available Providers",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "category_l1": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L1"
          },
          "category_l2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L2"
          },
          "category_source": {
            "title": "Category Source",
            "type": "string"
          },
          "feedback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeedbackRecord"
              },
              {
                "type": "null"
              }
            ]
          },
          "feedback_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback At"
          }
        },
        "required": [
          "id",
          "created_at",
          "query",
          "available_providers",
          "provider",
          "category_l1",
          "category_l2",
          "category_source",
          "feedback",
          "feedback_at"
        ],
        "title": "SearchOut",
        "type": "object"
      },
      "SearchPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchOut"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "SearchPageOut",
        "type": "object"
      },
      "ProviderStatsOut": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "num_searches": {
            "title": "Num Searches",
            "type": "integer"
          },
          "num_feedback": {
            "title": "Num Feedback",
            "type": "integer"
          },
          "num_good": {
            "title": "Num Good",
            "type": "integer"
          },
          "good_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Good Rate"
          }
        },
        "required": [
          "provider",
          "num_searches",
          "num_feedback",
          "num_good",
          "good_rate"
        ],
        "title": "ProviderStatsOut",
        "type": "object"
      },
      "TrafficBucketOut": {
        "properties": {
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "by_provider": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "By Provider",
            "type": "object"
          },
          "good": {
            "title": "Good",
            "type": "integer"
          },
          "bad": {
            "title": "Bad",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "by_provider",
          "good",
          "bad",
          "pending"
        ],
        "title": "TrafficBucketOut",
        "type": "object"
      },
      "TrafficOut": {
        "properties": {
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "bucket_seconds": {
            "title": "Bucket Seconds",
            "type": "integer"
          },
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/TrafficBucketOut"
            },
            "title": "Buckets",
            "type": "array"
          }
        },
        "required": [
          "start",
          "end",
          "bucket_seconds",
          "buckets"
        ],
        "title": "TrafficOut",
        "type": "object"
      },
      "DistributionHistoryOut": {
        "properties": {
          "l1": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "L1"
          },
          "snapshots": {
            "items": {
              "$ref": "#/components/schemas/SnapshotOut"
            },
            "title": "Snapshots",
            "type": "array"
          }
        },
        "required": [
          "l1",
          "snapshots"
        ],
        "title": "DistributionHistoryOut",
        "type": "object"
      },
      "ProviderPosteriorOut": {
        "properties": {
          "alpha": {
            "title": "Alpha",
            "type": "number"
          },
          "beta": {
            "title": "Beta",
            "type": "number"
          },
          "p_best": {
            "title": "P Best",
            "type": "number"
          },
          "n_obs": {
            "title": "N Obs",
            "type": "integer"
          }
        },
        "required": [
          "alpha",
          "beta",
          "p_best",
          "n_obs"
        ],
        "title": "ProviderPosteriorOut",
        "type": "object"
      },
      "SnapshotOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "is_reset": {
            "title": "Is Reset",
            "type": "boolean"
          },
          "by_provider": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ProviderPosteriorOut"
            },
            "title": "By Provider",
            "type": "object"
          }
        },
        "required": [
          "id",
          "created_at",
          "is_reset",
          "by_provider"
        ],
        "title": "SnapshotOut",
        "type": "object"
      },
      "CategoryCellOut": {
        "properties": {
          "l1": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "L1"
          },
          "by_provider": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ProviderPosteriorOut"
            },
            "title": "By Provider",
            "type": "object"
          }
        },
        "required": [
          "l1",
          "by_provider"
        ],
        "title": "CategoryCellOut",
        "type": "object"
      },
      "SnapshotCategoriesOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CategoryCellOut"
            },
            "title": "Cells",
            "type": "array"
          }
        },
        "required": [
          "id",
          "created_at",
          "cells"
        ],
        "title": "SnapshotCategoriesOut",
        "type": "object"
      },
      "SearchDistributionStatus": {
        "properties": {
          "distribution_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distribution Id"
          },
          "computed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Computed At"
          },
          "num_feedback": {
            "title": "Num Feedback",
            "type": "integer"
          },
          "num_cells": {
            "title": "Num Cells",
            "type": "integer"
          },
          "counts_since": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counts Since"
          }
        },
        "required": [
          "distribution_id",
          "computed_at",
          "num_feedback",
          "num_cells",
          "counts_since"
        ],
        "title": "SearchDistributionStatus",
        "type": "object"
      }
    }
  },
  "servers": []
}