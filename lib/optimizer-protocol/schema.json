  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "WhichSearchResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "feedback_token"
        ],
        "title": "WhichSearchResponse",
        "type": "object"
      },
      "WhichSearchRequest": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Available Providers",
            "type": "array"
          }
        },
        "required": [
          "query",
          "available_providers"
        ],
        "title": "WhichSearchRequest",
        "type": "object"
      },
      "SubmitFeedbackResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "SubmitFeedbackResponse",
        "type": "object"
      },
      "SubmitFeedbackRequest": {
        "properties": {
          "feedback_token": {
            "format": "uuid",
            "title": "Feedback Token",
            "type": "string"
          },
          "is_good": {
            "title": "Is Good",
            "type": "boolean"
          }
        },
        "required": [
          "feedback_token",
          "is_good"
        ],
        "title": "SubmitFeedbackRequest",
        "type": "object"
      },
      "SearchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "available_providers": {
            "items": {
              "type": "string"
            },
            "title": "Available Providers",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "is_good": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Good"
          }
        },
        "required": [
          "id",
          "created_at",
          "query",
          "available_providers",
          "provider",
          "is_good"
        ],
        "title": "SearchOut",
        "type": "object"
      },
      "ProviderStatsOut": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "num_searches": {
            "title": "Num Searches",
            "type": "integer"
          },
          "num_feedback": {
            "title": "Num Feedback",
            "type": "integer"
          },
          "num_good": {
            "title": "Num Good",
            "type": "integer"
          },
          "good_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Good Rate"
          }
        },
        "required": [
          "provider",
          "num_searches",
          "num_feedback",
          "num_good",
          "good_rate"
        ],
        "title": "ProviderStatsOut",
        "type": "object"
      }
    }
  },
  "servers": []
}